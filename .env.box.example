# SimpliGame — environment for the OWN-BOX (Docker Compose) deployment.
#
#   cp .env.box.example .env
#   # fill in the values below, then: docker compose up -d --build
#
# NEVER commit a filled-in .env. Every variable the app code reads is
# listed here (audited against process.env in server/src). Variables
# marked COMPOSE are consumed by docker-compose.yml itself.

# ------------------------------------------------------------------
# Compose wiring (consumed by docker-compose.yml)

# Password for the box Postgres. Compose builds the app's
# DATABASE_URL from it:
#   postgres://simpligame:<POSTGRES_PASSWORD>@db:5432/simpligame
# Keep it URL-safe: letters, numbers, and - _ . only (no @ : / # ?).
POSTGRES_PASSWORD=

# MinIO root login (the box's future S3 storage; the app does not use
# MinIO yet — these just bring the service up secured).
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# ------------------------------------------------------------------
# App configuration

# The app's public address on the box — the tunnel hostname
# (Tailscale Funnel / Cloudflare Tunnel), e.g.
#   PUBLIC_URL=https://simpligame.<your-tailnet>.ts.net
# Used for texted watch links, the Google OAuth redirect base, and
# upload-session origins. Until the tunnel exists, the localhost
# fallback below works for on-box checks only.
PUBLIC_URL=http://localhost:4000

# Shared secret for the local worker (AI Vision / future render
# worker). Must match WORKER_KEY where the worker runs. Any long
# random string; never reuse a password, never paste it in chat.
WORKER_KEY=

# ------------------------------------------------------------------
# Google OAuth — one client powers BOTH features below.
# (Same values as the current Render env vars — copy them from the
# Render dashboard, never from chat.)

# Sheets export: the app acts as this Google account.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# Optional: share each exported Sheet with this email as writer;
# without it the Sheet is anyone-with-link reader.
# GOOGLE_SHARE_EMAIL=
#
# Per-user Drive import uses the same client id/secret (each user's
# own refresh token is stored on their user row — migration 011).
# On the box PUBLIC_URL changes, so also add the new redirect URI to
# the OAuth client in Google Cloud:
#   <PUBLIC_URL>/api/auth/google/callback

# ------------------------------------------------------------------
# Family SMS (Twilio). All three or none: with any missing, the app
# runs in log-only mode (attempts recorded, nothing claimed sent).
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+1...

# ------------------------------------------------------------------
# Managed by compose (listed so nothing is a surprise — you do not
# set these; docker-compose.yml does):
#   NODE_ENV=production
#   PORT=4000
#   DATABASE_URL=postgres://simpligame:<POSTGRES_PASSWORD>@db:5432/simpligame
#     (host `db` = the compose Postgres; server/src/db.ts connects
#     WITHOUT SSL to local/compose hosts and WITH SSL to hosted ones)
#
# PGSSL — optional override of the db.ts SSL rule (require|disable).
# Leave unset on the box and on Render.
# PGSSL=
