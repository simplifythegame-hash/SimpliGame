# Copy to .env and fill in your values. Never commit a real .env.
# Local dev: point DATABASE_URL at a local Postgres or a free Neon project.
DATABASE_URL=postgres://user:password@host:5432/simpligame
PORT=4000
# Family SMS (Twilio). Leave unset to run in log-only mode: every text
# attempt is recorded, nothing is claimed sent.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+1...
# PUBLIC_URL=https://simpligame.onrender.com
# Google Sheets export (service account). Leave unset to run without
# Sheets: the Export button reports "not configured" and the CSV
# download still works. Never paste the private key in chat.
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# GOOGLE_SHARE_EMAIL=  (optional — Sheet is shared with this email as
#   writer; without it the Sheet is anyone-with-link reader)
